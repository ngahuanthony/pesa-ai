# ─── Pesa AI — Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in every value.
# Never commit .env to git.
#
# On Hetzner: nano /opt/pesa-ai/.env

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Admin panel ─────────────────────────────────────────────────────────────
# Strong password for the /admin panel. Use a password manager to generate one.
ADMIN_PASSWORD=change-me-use-a-strong-password

# ── Security ─────────────────────────────────────────────────────────────────
# 64-character random hex string. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Session secret for cookie signing. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── WhatsApp / Meta ──────────────────────────────────────────────────────────
# From Meta Developer Console → App → App Settings → Basic → App Secret
WHATSAPP_APP_SECRET=

# Token you set in Meta Developer Console → WhatsApp → Configuration
WHATSAPP_VERIFY_TOKEN=pesaai-verify-2026

# Your WABA (WhatsApp Business Account) ID — shared across all vendors
WHATSAPP_PLATFORM_WABA_ID=

# System user permanent token from Meta Business Manager
# (Meta Business Manager → System Users → your user → Generate Token → whatsapp_business_messaging)
WHATSAPP_PLATFORM_TOKEN=

# ── M-Pesa (Safaricom Daraja) ────────────────────────────────────────────────
# These are per-business and stored encrypted in the database.
# The ENCRYPTION_KEY above must be set before saving M-Pesa credentials.

# ── AI / Claude (Anthropic) ─────────────────────────────────────────────────
# Get from https://console.anthropic.com → API Keys
# Claude Haiku costs ~$0.25 per million tokens — very cheap for scanning
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-haiku-4-5)
# ANTHROPIC_MODEL=claude-haiku-4-5

# ── Object Storage (Replit only — leave blank on Hetzner) ───────────────────
# On Hetzner, data is stored in artifacts/api-server/data/db.json on disk.
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
